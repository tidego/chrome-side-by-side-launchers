# Paths to official, unmodified Chrome side-by-side installations.
BETA_APP="/Applications/Google Chrome Beta.app"
CANARY_APP="/Applications/Google Chrome Canary.app"

# Where generated launcher apps should be placed.
OUTPUT_DIR="$HOME/Desktop"

# Separate data directories. Do not point two launchers at the same directory.
PROFILE_1="$HOME/Chrome_Profiles/Profile_1_Beta"
PROFILE_2="$HOME/Chrome_Profiles/Profile_2_Canary"

# Optional per-launcher proxy. Leave PROXY_2 empty for direct Canary traffic.
PROXY_1="http://127.0.0.1:7897"
PROXY_2=""

LANG_1="en-US"
LANG_2=""

# Optional local customization hooks. Each non-empty, non-comment line in an
# args file becomes one argument. A hook receives: $1=profile_dir, $2=chrome_bin.
EXTRA_ARGS_1_FILE="$HOME/Chrome_Profiles/local/chrome1.args"
EXTRA_ARGS_2_FILE="$HOME/Chrome_Profiles/local/chrome2.args"
BEFORE_LAUNCH_1="$HOME/Chrome_Profiles/local/chrome1-before-launch.sh"
BEFORE_LAUNCH_2="$HOME/Chrome_Profiles/local/chrome2-before-launch.sh"
